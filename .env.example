# Supabase (Project Settings > API). Leave empty to run on the built-in sample data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: n8n webhook that sends a notification when a published roster changes
VITE_N8N_WEBHOOK_URL=

# Server-side only: set as an Edge Function secret (never in the browser)
# ANTHROPIC_API_KEY=
